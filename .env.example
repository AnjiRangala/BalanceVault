NODE_ENV=development
API_PORT=3001
PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_READY_TIMEOUT_MS=1500
REDIS_URL=redis://127.0.0.1:6379/0

# Runtime login must be a non-superuser member of balancevault_runtime only.
# Keep this credential separate from migration credentials.
DATABASE_URL=

# Supply only to the migration pipeline. Never configure it on the API service.
MIGRATION_DATABASE_URL=

# Generate with: openssl rand -base64 48. Use a secret manager in production.
JWT_ACCESS_SECRET=
